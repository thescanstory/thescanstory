# ⚠️  CRITICAL SECURITY WARNING ⚠️
# 
# 1. NEVER commit this file to version control (it's in .gitignore)
# 2. CHANGE THE DEFAULT PASSWORD before deploying to production
# 3. In production, use strong, randomly-generated credentials
# 4. The admin email must match the seeded user in Supabase Auth
#
# Copy this file to .env.local and fill in the values.
# Run `supabase status` after `supabase start` to get the local URL/keys below.

# =============================================================================
# PRODUCTION DEPLOYMENT FOR www.thescanstory.com
# =============================================================================

# --- Production Supabase (get from supabase.com/dashboard) ---
# IMPORTANT: Use production Supabase project, not local dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# =============================================================================
# ADMIN AUTHENTICATION (seeded via `npm run db:seed:admin`)
# =============================================================================
# ⚠️  MUST change ADMIN_PASSWORD before production deployment!
# Use a strong password (min 8 characters, mix of letters, numbers, symbols)
ADMIN_EMAIL=admin@thescanstory.com
ADMIN_PASSWORD=change-me-please-CHANGE-THIS-IN-PRODUCTION

# =============================================================================
# PAYMENTS (Razorpay)
# =============================================================================
# For production: Use live keys (rzp_live_*), not test keys
# Get live keys from: https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_live_secret

# Webhook secret (from Razorpay Dashboard -> Settings -> Webhooks)
# Register: https://www.thescanstory.com/api/webhooks/razorpay
# Leave blank to reject all webhook requests (safe default)
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# =============================================================================
# EMAIL (Resend)
# =============================================================================
# Get API key from: https://resend.com/api-keys
# Verify your domain in Resend dashboard (thescanstory.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# =============================================================================
# SMS (MSG91 - for OTP + shipped notifications)
# =============================================================================
# Leave all blank to run in simulated/console-log mode
# Requires DLT registration with Indian telecom operator for production
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=your_sender_id
# MSG91_OTP_TEMPLATE_ID=your_otp_template_id
# MSG91_SHIPPED_TEMPLATE_ID=your_shipped_template_id

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Cash on Delivery handling fee (in paise, e.g., 4900 = ₹49)
COD_HANDLING_FEE_PAISE=4900

# Production URL (REQUIRED for experience link generation)
NEXT_PUBLIC_APP_URL=https://www.thescanstory.com

