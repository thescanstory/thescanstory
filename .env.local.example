# Copy to .env.local and fill in. Run `supabase status` after `supabase start`
# to get the local URL/keys below.

# --- Supabase (local dev stack) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# When testing on a phone over the LAN, point these at your Mac's LAN IP
# instead of 127.0.0.1 (the phone can't resolve localhost to your machine).
# NEXT_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321
# SUPABASE_URL=http://192.168.x.x:54321

# --- Supabase (Cloud project, e.g. no Docker available) ---
# Get these from supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth (single admin user, seeded via `npm run db:seed:admin`) ---
ADMIN_EMAIL=admin@scanstory.dev
ADMIN_PASSWORD=change-me-please

# --- Razorpay (leave blank/placeholder to run in simulated "Test Mode" —
# COD checkout works with zero keys; Online checkout auto-falls into a
# clearly-labeled mock flow until real rzp_test_ keys are set here) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard -> Settings -> Webhooks, after registering
# https://<your-domain>/api/webhooks/razorpay subscribed to payment.captured.
# Leave blank to have the webhook route reject all requests (safe default).
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (leave blank/placeholder to run shipment emails in a
# clearly-labeled simulated mode — set a real re_ key here to send for
# real; sends from onboarding@resend.dev until you verify your own domain
# in the Resend dashboard and swap FROM_ADDRESS in lib/notify/notify.ts) ---
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- MSG91 (SMS for OTP + shipped notifications — leave all four blank to
# run in simulated/console-log mode). Requires DLT registration with an
# Indian telecom operator before real sending works: register as an
# entity, get a sender ID approved, and get the two message templates
# below approved with {{OTP}} / {{LINK}} as the exact variable names —
# an unregistered sender is silently blocked, not just undelivered. ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_SHIPPED_TEMPLATE_ID=

# --- COD ---
COD_HANDLING_FEE_PAISE=4900

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
